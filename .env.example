# Resend - https://resend.com/api-keys
# Add the same keys in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxx

# Must use a Resend-verified domain (https://resend.com/domains).
PILOT_FROM_EMAIL=Damaros <team@damaros.ai>
PILOT_TO_EMAIL=team@damaros.ai

# Vercel CLI deploy - https://vercel.com/account/tokens
# Copy this file to .env.local and paste the token there. Never commit .env.local.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
